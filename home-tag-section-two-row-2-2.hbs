{{!-- Markup to show the tag section in two column format in 2|2 layout on homepage --}}
<section class="home-tag-2-2 tag-section-{{slug}} py-10 xs:py-12 md:py-16">
    <div class="wrapper flex flex-col gap-6">
        <div class="flex items-center justify-between gap-4">
            <h1 class="home-tag-title font-heading text-[--text-primary] text-2xl xs:text-3xl lg:text-4xl font-medium leading-normal"> {{name}} </h1>
            <a aria-label="{{name}}" href="{{url}}" class="flex items-center gap-2 group">
                <span class="text-[--text-primary] text-sm font-medium"> {{t "Read all in "}}{{name}} </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 transition-transform group-hover:translate-x-1 icon icon-tabler icon-tabler-arrow-right">
    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
    <path d="M5 12l14 0" />
    <path d="M13 18l6 -6" />
    <path d="M13 6l6 6" />
</svg>
            </a>
        </div>
        <div class="bg-[--border-color] h-px w-full"></div>
        <div class="grid grid-cols-1 xs:grid-cols-2 gap-10 xs:gap-5 md:gap-8">
            {{#get 'posts' filter='tags:{{slug}}' limit="4" include="tags,authors"}}
                {{#foreach posts}}
                    <div class="home-tag-card h-[7.5rem] lg:h-max group flex flex-col gap-2">
                        <div class="flex gap-5 h-full">
                            {{#if feature_image}}
                                <div class="flex-shrink-0 md:flex-shrink h-full aspect-square xs:aspect-[1.5] overflow-hidden rounded-sm relative">
                                    <a aria-label="{{title}}" href="{{url}}">
                                        {{> images/feature-image-xl show_caption=false classes="home-tag-card-img h-full w-full max-w-xl object-cover object-center group-hover:scale-[1.025] transition-transform duration-300"}}
                                    </a>
                                    {{> post-identifier-icons
                                        div_classes="aspect-square rounded-sm flex items-center justify-center cursor-pointer absolute top-1 h-6 bg-black/50 backdrop-blur-lg right-1"
                                        img_classes="filter-white h-4"
                                        is_featured_icon_left=true
                                    }}
                                </div>
                            {{/if}}
                            <div class="flex flex-col justify-between gap-4 xs:gap-2">
                                <div class="flex flex-col gap-2">
                                    {{#if tags}}
                                        <div class="home-tag-card-tags flex items-center gap-2 flex-wrap">
                                            {{#foreach tags}}
                                                <a aria-label="{{name}}" href="{{url}}" class="text-sm text-[--text-accent] font-medium py-0.5 w-min rounded-sm text-nowrap uppercase"> {{name}} </a>
                                            {{/foreach}}
                                        </div>
                                    {{/if}}
                                    <a aria-label="{{title}}" href="{{url}}">
                                        <h2 class="home-tag-card-title font-heading text-[--text-primary] font-medium text-sm xs:text-xl hover:underline underline-offset-2"> {{title}} </h2>
                                    </a>
                                    {{> post-meta}}
                                </div>
                            </div>
                        </div>
                    </div>
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>