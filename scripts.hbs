{{#if global}}
    <script>
        // Capture user overrides if they exist
        const USER_OVERRIDES = window.GLOBAL || {};
        // Define defaults
        const GLOBAL_DEFAULTS = {
            //------------------------------------------------------------------------------------------------------------------------------
            //Do not change below variables
            //------------------------------------------------------------------------------------------------------------------------------
            CURRENT_PAGE: parseInt('{{pagination.page}}'),
            NEXT_PAGE: parseInt('{{pagination.next}}'),
            NEXT_PAGE_LINK: '',
            MAX_PAGES: parseInt('{{pagination.pages}}'),
            LAST_PAGE: `{{pagination.page}}` === `{{pagination.pages}}`,
            POSTS_PER_PAGE: parseInt('{{@config.posts_per_page}}'),
            TOTAL_POSTS: parseInt('{{pagination.total}}'),
            MAIN_LOCALE: '{{#if @custom.main_locale}}{{@custom.main_locale}}{{else}}en{{/if}}',
            LOCALES: '{{#if @custom.locales}}{{@custom.locales}}{{/if}}',
            ROOT_LOCALE: '{{@site.locale}}',
            //------------------------------------------------------------------------------------------------------------------------------
            //Modify the below variables as per your requirements in Code Injection. Read the docs for more info.
            //------------------------------------------------------------------------------------------------------------------------------
            //1. Open external links in a new tab?
            OPEN_LINKS_IN_NEW_TAB: true,//accepted values: true, false
            //2. Enable image lightbox popup?
            ENABLE_IMAGE_LIGHTBOX: true,//accepted values: true, false
            //3. Auto hide the navigation header when scrolling down?
            AUTO_HIDE_HEADER: true,//accepted values: true, false
            //4. Default color scheme (light/dark/system)
            DEFAULT_COLOR_SCHEME: 'system',//accepted values: dark, light, system
            //5. Turn on if you want to automatically redirect a visitor to the website in visitor's browser language.
            REDIRECT_ON_LOCALE: false, //accepted values: true, false
            //6. Pagination style (load-more/paginated-pages) - Only applicable on paginated content for posts. Authors and Tags pages will always be 'load more' button.
            PAGINATION_STYLE: 'load-more', //accepted values: load-more, paginated-pages
            //7. Contact Endpoint for the Contact form on the Contact page
            CONTACT_ENDPOINT: '',//If no endpoint is added, the contact form will be hidden
            //8. Contact Page WhatsApp link
            WHATSAPP_LINK: '',//If no link is added, the WhatsApp will be hidden
            //9. Use locale-specific domains instead of /{lang}/ paths? Provide locale-specific domains in LOCALE_DOMAINS variable below.
            USE_LOCALE_DOMAINS: false,//accepted values: true, false
            //10. Map language code to domain (e.g., { en: "englishdomain.com", hi: "hindidomain.com", es: "spanishdomain.com"})
            LOCALE_DOMAINS: {},
            //11. When switching locale domains, open the homepage instead of keeping the current path?
            LOCALE_DOMAIN_HOME_ONLY: false,//accepted values: true, false
            //12. Comma-separated paths to keep when LOCALE_DOMAIN_HOME_ONLY is enabled (e.g., "account, membership, signin")
            LOCALE_DOMAIN_HOME_IGNORE_PATHS: '',//empty means redirect all paths to the homepage
        };

        // Merge: user overrides take precedence over global defaults
        window.GLOBAL = Object.assign({}, GLOBAL_DEFAULTS, USER_OVERRIDES);
        const GLOBAL = window.GLOBAL;

        const locales = GLOBAL.LOCALES.split(',');
        let allLangCodes = [];
        locales.forEach(function (locale) {
            const langCode = locale.split("-")[0];
            allLangCodes.push(langCode);
        });
    </script>
{{/if}}

