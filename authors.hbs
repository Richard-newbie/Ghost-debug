{{!-- Official Ghost Content API client (UMD) --}}
<script src="https://unpkg.com/@tryghost/content-api@1.12.0/umd/content-api.min.js" defer></script>

<script>
    (function () {
        function onReady(fn){document.readyState !== 'loading' ? fn() : document.addEventListener('DOMContentLoaded', fn);}

        onReady(function(){
            var $btn  = document.getElementById('load-authors');
            var $grid = document.getElementById('authors-grid');
            if (!$btn || !$grid) return;

            // Get API config: prefer data-attrs; fall back to globals or origin
            var apiUrl = ($btn.dataset.apiUrl || window.GHOST_API_URL || window.location.origin).replace(/\/$/, '');
            var apiKey = $btn.dataset.apiKey || window.GHOST_CONTENT_API_KEY;

            if (typeof GhostContentAPI === 'undefined') {
                console.warn('GhostContentAPI library not loaded.');
                return;
            }
            if (!apiKey) {
                console.warn('Ghost Content API key not found. Define window.GHOST_CONTENT_API_KEY in code injection.');
                return;
            }

            var api = new GhostContentAPI({ url: apiUrl, key: apiKey, version: 'v6.0' });

            var page    = parseInt($btn.dataset.startPage || '2', 10); // next page after SSR
            var limit   = GLOBAL.POSTS_PER_PAGE; // Ghost’s max page size is 100. Change this number to change number of authors to load at a time.
            var hasMore = true;
            var loading = false;

            function setAllLoadedState(){
                $btn.disabled = true;
                $btn.setAttribute('aria-disabled', 'true');
                $btn.classList.add('opacity-60','cursor-not-allowed');
                $btn.textContent = '{{t "All Authors Loaded"}}';
                $btn.title = '{{t "All Authors Loaded"}}';
            }
            function restoreButtonLabel(label){
                $btn.disabled = false;
                $btn.removeAttribute('aria-disabled');
                $btn.classList.remove('opacity-60','cursor-not-allowed');
                $btn.textContent = label;
                $btn.removeAttribute('title');
            }

            function postCountText(n){
                if (typeof n !== 'number') return '';
                if (n === 0) return '{{t "No posts"}}';
                if (n === 1) return "{{t '1 post'}}";
                return n + "{{t ' posts'}}";
            }

            // Map your theme sizes to exact widths (match your package.json)
            const GHOST_WIDTHS = { xxs: 50, xs: 100, s: 300, m: 500, l: 700 };

            // Locale prefix detector: "/es/*" -> "/es", otherwise ""
            const LOCALE_SEGMENT_RE = /^[a-z]{2}(?:-[a-z]{2})?$/i;
            const localePrefix = (function getLocalePrefix() {
                const first = window.location.pathname.split('/').filter(Boolean)[0] || '';
                return LOCALE_SEGMENT_RE.test(first) ? `/${first}` : '';
            })();

            // Is this a Ghost-managed image under /content/images ?
            function isGhostManaged(src) {
                try {
                    const u = new URL(src, window.location.origin);
                    return /\/content\/images\//i.test(u.pathname);
                } catch { return false; }
            }

            // Escape basic HTML (for alt text, etc.)
            function esc(s){ return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

            /**
             * Build a Ghost transform URL with locale-aware base path:
             */
            function ghostTransformedUrl(src, { width, format } = {}) {
                if (!src) return "";
                try {
                    const u = new URL(src, window.location.origin);
                    if (!isGhostManaged(u.toString())) return "";

                    // Strip any leading "<locale>/content/images/" or "content/images/" from the original path
                    const CONTENT_PREFIX_RE = /^(?:\/[a-z]{2}(?:-[a-z]{2})?)?\/content\/images\//i;
                    const tail = u.pathname.replace(CONTENT_PREFIX_RE, "");

                    const fmt = format ? `format/${format}/` : "";
                    // Insert localePrefix if present, then compose final path
                    u.pathname = `${localePrefix}/content/images/size/w${width}/${fmt}${tail}`.replace(/\/{2,}/g, '/');
                    return u.toString();
                } catch {
                    return "";
                }
            }

            // Build a srcset string from widths (e.g. [50,100,...]) and optional format
            function buildSrcset(src, widths, format) {
                const parts = [];
                for (const w of widths) {
                    const url = ghostTransformedUrl(src, { width: w, format });
                    if (!url) return ""; // if any transform fails, bail to non-picture fallback
                    parts.push(`${url} ${w}w`);
                }
                return parts.join(", ");
            }

            function authorPictureHTML(a, classes = "h-full w-full object-center object-cover group-hover:scale-[1.025] transition-transform") {
                const img = a && a.profile_image;
                if (!img) return "";

                const widths = [GHOST_WIDTHS.xxs, GHOST_WIDTHS.xs, GHOST_WIDTHS.s, GHOST_WIDTHS.m, GHOST_WIDTHS.l];
                const sizesAttr = '((max-width: 50px)) 50px, ((min-width: 50px) and (max-width: 100px)) 100px, ((min-width: 100px) and (max-width: 300px)) 300px, ((min-width: 300px) and (max-width: 500px)) 500px, (min-width: 500px) 700px';

                const avifSet = buildSrcset(img, widths, "avif");
                const webpSet = buildSrcset(img, widths, "webp");
                const jpgSet  = buildSrcset(img, widths, undefined);
                const srcL    = ghostTransformedUrl(img, { width: GHOST_WIDTHS.l }) || img; // fallback to original

                // If transforms worked, output <picture> with AVIF/WebP sources + fallback <img>
                if (avifSet && webpSet && jpgSet) {
                    return (
                        '<a href="'+a.url+'" aria-label="'+esc(a.name)+'" class="section-authors-img w-full aspect-[1.3] overflow-hidden">'
                        + '<picture>'
                        // Tip from your HBS: remove AVIF source if you expect animated images
                        + '<source srcset="'+avifSet+'" sizes="'+sizesAttr+'" type="image/avif">'
                        + '<source srcset="'+webpSet+'" sizes="'+sizesAttr+'" type="image/webp">'
                        + '<img loading="lazy" decoding="async"'
                        + ' srcset="'+jpgSet+'" src="'+srcL+'" sizes="'+sizesAttr+'"'
                        + ' class="'+esc(classes)+'" alt="'+esc(a.name)+'">'
                        + '</picture>'
                        + '</a>'
                    );
                }

                // Fallback: no transforms (external image/CDN) → just use original <img>
                return (
                    '<a href="'+a.url+'" aria-label="'+esc(a.name)+'" class="section-authors-img w-full aspect-[1.3] overflow-hidden">'
                    + '<img src="'+img+'" alt="'+esc(a.name)+'" loading="lazy" class="'+esc(classes)+'">'
                    + '</a>'
                );
            }

            function normalizeMastodonUrl(value, defaultInstance = "") {
                if (!value) return "";
                const v = String(value).trim();

                // Already a full URL
                if (/^https?:\/\//i.test(v)) return v;

                // Domain/path without scheme, e.g. mastodon.social/@max
                if (/^[a-z0-9.-]+\.[a-z]{2,}\/@[^/\s]+$/i.test(v)) {
                    return `https://${v}`;
                }

                // @user@server or user@server
                const parts = v.replace(/^@/, "").split("@");
                if (parts.length === 2 && parts[0] && parts[1]) {
                    const user = parts[0];
                    const host = parts[1];
                    return `https://${host}/@${user}`;
                }

                // Only @user (no server) — fall back to default instance if provided
                if (defaultInstance) {
                    const host = String(defaultInstance).replace(/^https?:\/\//i, "").replace(/\/+$/,"");
                    const user = v.replace(/^@/, "");
                    return `https://${host}/@${user}`;
                }

                // Can't construct a valid URL
                return "";
            }

            function socialLinksHTML(a, opts = {}) {
                const parts = [];
                const val = (x) => (typeof x === 'string' ? x.trim() : '');
                const isUrl = (s) => /^https?:\/\//i.test(s);

                const iconSvg = (name) => {
                    const tpl = document.getElementById(`tpl-icon-${name}`) || document.getElementById('tpl-icon-globe');
                    return tpl ? tpl.innerHTML : '';
                };

                const anchor = (name, label, href, extraRel = '') =>
                    `<a href="${href}" class="social-link ${a.name} ${name}" data-network="${name}" target="_blank" rel="noopener ${extraRel}" aria-label="${label}" title="${label}">
                       ${iconSvg(name)}
                     </a>`;

                // X / Twitter
                if (val(a.twitter)) {
                    const u = val(a.twitter);
                    parts.push(anchor('twitter', 'Twitter', isUrl(u) ? u : `https://x.com/${u.replace(/^@/, '')}`));
                }

                // Facebook
                if (val(a.facebook)) {
                    const u = val(a.facebook);
                    parts.push(anchor('facebook', 'Facebook', isUrl(u) ? u : `https://facebook.com/${u.replace(/^\//, '')}`));
                }

                // LinkedIn
                if (val(a.linkedin)) {
                    const u = val(a.linkedin);
                    parts.push(anchor('linkedin', 'LinkedIn', isUrl(u) ? u : `https://www.linkedin.com/in/${u.replace(/^@/, '')}`));
                }

                // Bluesky
                if (val(a.bluesky)) {
                    const u = val(a.bluesky);
                    parts.push(anchor('bluesky', 'Bluesky', isUrl(u) ? u : `https://bsky.app/profile/${u.replace(/^@/, '')}`));
                }

                // Threads
                if (val(a.threads)) {
                    const u = val(a.threads);
                    parts.push(anchor('threads', 'Threads', isUrl(u) ? u : `https://www.threads.net/@${u.replace(/^@/, '')}`));
                }

                // Mastodon (full URL or @user@server)
                if (val(a.mastodon)) {
                    const href = normalizeMastodonUrl(val(a.mastodon), opts.mastodonInstance);
                    if (href) parts.push(anchor('mastodon', 'Mastodon', href, 'me'));
                }

                // TikTok
                if (val(a.tiktok)) {
                    const u = val(a.tiktok);
                    parts.push(anchor('tiktok', 'TikTok', isUrl(u) ? u : `https://www.tiktok.com/@${u.replace(/^@/, '')}`));
                }

                // YouTube
                if (val(a.youtube)) {
                    const u = val(a.youtube);
                    parts.push(anchor('youtube', 'YouTube', isUrl(u) ? u : `https://www.youtube.com/@${u.replace(/^@/, '')}`));
                }

                // Instagram
                if (val(a.instagram)) {
                    const u = val(a.instagram);
                    parts.push(anchor('instagram', 'Instagram', isUrl(u) ? u : `https://www.instagram.com/${u.replace(/^@/, '')}/`));
                }

                // Website
                if (val(a.website)) {
                    parts.push(anchor('website', 'Website', val(a.website)));
                }

                return parts.length ? `<div class="flex flex-wrap items-center gap-3 text-sm">${parts.join('')}</div>` : '';
            }


            function authorCardHTML(a){
                var imgHTML = authorPictureHTML(a);

                return (
                    '<div class="section-authors-card border border-[--border-color] hover:border-[--text-primary] flex flex-col rounded-sm group">'
                    + imgHTML
                    + '<div class="flex flex-1 flex-col justify-between gap-4 p-5 xs:p-6">'
                    + '<a href="'+a.url+'" aria-label="'+a.name+'" class="flex flex-col gap-1.5">'
                    + '<h2 class="section-authors-name font-heading font-medium text-[--text-primary] text-lg xs:text-xl lg:text-2xl hover:text-[--text-secondary]">'+a.name+'</h2>'
                    + (a.bio ? '<p class="section-authors-bio text-[--text-secondary] font-medium text-sm">'+a.bio+'</p>' : '')
                    + '</a>'
                    + '<div class="flex flex-col justify-between gap-4">'
                    + socialLinksHTML(a)
                    + '<a href="'+a.url+'" aria-label="More articles by '+a.name+'" class="flex items-center gap-2">'
                    + '<span class="text-[--text-primary] text-sm font-medium">'+postCountText(a.count && a.count.posts)+'</span>'
                    + '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 transition-transform group-hover:translate-x-1 icon icon-tabler icon-tabler-arrow-right">
    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
    <path d="M5 12l14 0" />
    <path d="M13 18l6 -6" />
    <path d="M13 6l6 6" />
</svg>'
                    + '</a>'
                    + '</div>'
                    + '</div>'
                    + '</div>'
                );
            }

            // ---- Preflight: if the SSR page already contains all authors, disable & relabel immediately
            var ssrCount = $grid.querySelectorAll('.section-authors-card').length;

            if (ssrCount === 0 || ssrCount < limit) {
                // Fewer than 100 authors rendered ⇒ no page 2
                hasMore = false;
                setAllLoadedState();
            } else {
                // Exactly 100 rendered: check if a next page exists by probing page 2 with limit=1
                api.authors.browse({ page: page, limit: 1, fields: 'id' })
                    .then(function (arr) {
                        if (!arr || !arr.length) {
                            hasMore = false;
                            setAllLoadedState();
                        }
                    })
                    .catch(function (err) {
                        if (err && (err.name === 'NotFoundError' || err.status === 404)) {
                            hasMore = false;
                            setAllLoadedState();
                        } else {
                            console.warn('Author page probe failed:', err);
                        }
                    });
            }

            async function loadNextPage(){
                if (loading || !hasMore) return;
                loading = true;
                var initialLabel = $btn.textContent;
                $btn.disabled = true;
                $btn.textContent = '{{t "Loading…"}}';

                try {
                    var list = await api.authors.browse({
                        page: page,
                        limit: limit,
                        include: 'count.posts',
                        order: 'count.posts desc'
                    });

                    list.forEach(function(a){
                        $grid.insertAdjacentHTML('beforeend', authorCardHTML(a));
                    });

                    var meta = list && list.meta && list.meta.pagination;
                    if (meta) {
                        hasMore = Boolean(meta.next);
                        page = meta.next || page;
                    } else {
                        hasMore = list.length === limit;
                        if (hasMore) page += 1;
                    }
                } catch (err) {
                    console.error(err);
                    var msg = document.createElement('p');
                    msg.className = 'text-center text-sm text-red-600';
                    msg.textContent = 'Failed to load authors: ' + (err && err.message ? err.message : err);
                    $grid.appendChild(msg);
                    // allow retry
                    hasMore = true;
                } finally {
                    loading = false;
                    if (hasMore) {
                        restoreButtonLabel(initialLabel);
                    } else {
                        setAllLoadedState();
                    }
                }
            }

            $btn.addEventListener('click', loadNextPage);
        });
    })();
</script>
