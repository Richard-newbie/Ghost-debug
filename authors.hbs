{{!< default}}
{{#contentFor 'title'}}{{t "Authors"}}{{/contentFor}}

{{#if @custom.enable_multilingual_features}}
    {{#contentFor 'hreflangs'}}
    {{!-- IMPORTANT: If you make any changes here, please copy these to error.hbs --}}
    {{!-- Main Language at www.example.com --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/authors/" hreflang="{{@custom.main_locale}}" />
        <link rel="alternate" href="{{@custom.main_locale_url}}/authors/" hreflang="x-default" />

        {{!-- If
            USE_LOCALE_DOMAINS = false
            LOCALE_DOMAIN_HOME_ONLY = false
            All Other Languages at www.example.com/hi/my-blog or www.example.com/es/my-blog etc.
        --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/hi/authors/" hreflang="hi" />
        <link rel="alternate" href="{{@custom.main_locale_url}}/es/authors/" hreflang="es" />

    {{!-- If
        USE_LOCALE_DOMAINS = true
        LOCALE_DOMAIN_HOME_ONLY = false
        All Other Languages at www.hindidomain.com/my-blog, www.spanishdomain.com/my-blog etc.
    --}}
    {{!--
    <link rel="alternate" href="www.hindidomain.com{{url}}" hreflang="hi" />
    <link rel="alternate" href="www.spanishdomain.com{{url}}" hreflang="es" />
    --}}

    {{!-- If
        LOCALE_DOMAIN_HOME_ONLY = true
        We cannot determine if all blogs/pages would be translated, so we do not add any alternate hreflangs.
    --}}
    {{/contentFor}}
{{/if}}

<section class="section-authors py-10 xs:py-12 md:py-16">
    <div class="wrapper flex flex-col gap-10 xs:gap-12 md:gap-16">
        <h1 class="section-authors-title font-heading text-[--text-primary] text-4xl xs:text-[2.75rem] md:text-5xl lg:text-[3.5rem] font-medium leading-none text-center">
            {{t "Authors"}}
        </h1>

        {{!-- GRID: first page (SSR) + subsequent pages (JS) --}}
        <div id="authors-grid" class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-10 xs:gap-5 md:gap-10">
            {{!-- Server-render the first page so the page has content without JS. The limit should match the limit var in the JS. --}}
            {{#get "authors" include="count.posts" limit=@config.posts_per_page order="count.posts desc"}}
                {{#if authors}}
                    {{#foreach authors}}
                        <div class="section-authors-card border border-[--border-color] hover:border-[--text-primary] flex flex-col rounded-sm group">
                            {{#if profile_image}}
                                <a href="{{url}}" aria-label="{{name}}" class="section-authors-img w-full aspect-[1.3] overflow-hidden">
                                    {{> images/profile-image-l classes="h-full w-full object-center object-cover group-hover:scale-[1.025] transition-transform"}}
                                </a>
                            {{/if}}
                            <div class="flex flex-1 flex-col justify-between gap-4 p-5 xs:p-6">
                                <a href="{{url}}" aria-label="{{name}}" class="flex flex-col gap-1.5">
                                    <h2 class="section-authors-name font-heading font-medium text-[--text-primary] text-lg xs:text-xl lg:text-2xl hover:text-[--text-secondary]">
                                        {{name}}
                                    </h2>
                                    {{#if bio}}
                                        <p class="section-authors-bio text-[--text-secondary] font-medium text-sm">{{bio}}</p>
                                    {{/if}}
                                </a>
                                <div class="flex flex-col justify-between gap-4">
                                    {{> author-social-links accounts=this size="size-5" slug=slug name=name website=website}}
                                    <a href="{{url}}" aria-label="More articles by {{name}}" class="flex items-center gap-2">
                                    <span class="text-[--text-primary] text-sm font-medium">
                                        {{plural count.posts empty=(t 'No posts') singular=(t '1 post') plural=(t '% posts')}}
                                    </span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-5 transition-transform group-hover:translate-x-1 icon icon-tabler icon-tabler-arrow-right">
    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
    <path d="M5 12l14 0" />
    <path d="M13 18l6 -6" />
    <path d="M13 6l6 6" />
</svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {{/foreach}}
                {{/if}}
            {{/get}}
        </div>

        {{!-- LOAD MORE BUTTON (disabled when done) --}}
        <div class="flex justify-center">
            <button
                id="load-authors"
                class="rounded-sm border border-[--border-color] px-5 py-2 text-sm font-medium text-[--text-primary] hover:border-[--text-primary]"
                data-start-page="2"  {{!-- because page 1 is SSR'ed above --}}
                aria-label="{{t 'Load More Authors'}}">
                {{t "Load More Authors"}}
            </button>
        </div>

        <noscript>
            <p class="text-center text-sm text-[--text-secondary] mt-2">
                {{t "Enable JavaScript to load more authors."}}
            </p>
        </noscript>
    </div>
</section>

