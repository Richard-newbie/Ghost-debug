{{!< default}}
{{#contentFor 'title' }}{{t "Account" }}{{/contentFor}}
{{#if @custom.enable_multilingual_features}}
    {{#contentFor 'hreflangs'}}
    {{!-- IMPORTANT: If you make any changes here, please copy these to error.hbs --}}
    {{!-- Main Language at www.example.com --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/account-free/" hreflang="{{@custom.main_locale}}"/>
        <link rel="alternate" href="{{@custom.main_locale_url}}/account-free/" hreflang="x-default"/>

        {{!-- If
            USE_LOCALE_DOMAINS = false
            LOCALE_DOMAIN_HOME_ONLY = false
            All Other Languages at www.example.com/hi/my-blog or www.example.com/es/my-blog etc.
        --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/hi/account-free/" hreflang="hi"/>
        <link rel="alternate" href="{{@custom.main_locale_url}}/es/account-free/" hreflang="es"/>

    {{!-- If
        USE_LOCALE_DOMAINS = true
        LOCALE_DOMAIN_HOME_ONLY = false
        All Other Languages at www.hindidomain.com/my-blog, www.spanishdomain.com/my-blog etc.
    --}}
    {{!--
    <link rel="alternate" href="www.hindidomain.com{{url}}" hreflang="hi" />
    <link rel="alternate" href="www.spanishdomain.com{{url}}" hreflang="es" />
    --}}

    {{!-- If
        LOCALE_DOMAIN_HOME_ONLY = true
        We cannot determine if all blogs/pages would be translated, so we do not add any alternate hreflangs.
    --}}
    {{/contentFor}}
{{/if}}
    <section class="section-author py-10">
        <div class="wrapper flex flex-col gap-10 xs:gap-12 md:gap-16">
                <div class="flex flex-col items-center justify-center gap-4 xs:gap-6 lg:gap-8">
                    <h1 class="section-author-name font-heading text-[--text-primary] text-2xl xs:text-4xl lg:text-[2.75rem] font-medium leading-none text-center">{{t "My Account"}}</h1>
                </div>
                <div class="h-px w-full bg-[--border-color]"></div>
                <div class="wrapper flex flex-col items-center gap-12">
                    <div class="flex flex-col gap-2 xs:gap-4"><h2 class="font-heading text-[--text-primary] text-xl font-medium leading-none text-center">Member details</h2></div>
                    <div class="grid grid-cols-1 gap-16 lg:gap-12 w-full md:max-w-[39rem] border border-[--border-color] rounded-sm p-6">
                        <div class="section-contact-social-links order-2 lg:order-1 flex flex-col gap-12">
                            <div>
                                    <div class="grid grid-cols-[auto_auto] md:grid-cols-[8rem_1fr] py-4 border-b border-[--border-color] text-sm gap-4 xs:gap-16 lg:gap-32 group">
                                        <div class="flex items-center gap-2">
                                            <div class="h-5 aspect-square">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="filter-theme icon icon-tabler icons-tabler-outline icon-tabler-user"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                                            </div>
                                            <div class="text-[--text-primary] font-medium">{{t "Name"}}</div>
                                        </div>
                                        <div class="flex items-center ml-auto">
                                            <div class="text-[--text-primary]">Jamie Smith</div>
                                        </div>
                                    </div>
                                <div class="grid grid-cols-[auto_auto] md:grid-cols-[8rem_1fr] py-4 border-b border-[--border-color] text-sm gap-4 xs:gap-16 lg:gap-32 group">
                                    <div class="flex items-center gap-2">
                                        <div class="h-5 aspect-square">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="filter-theme icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
                                        </div>
                                        <div class="text-[--text-primary] font-medium">{{t "Email"}}</div>
                                    </div>
                                    <div class="flex items-center ml-auto">
                                        <div class="text-[--text-primary]">jamie@example.com</div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-[auto_auto] md:grid-cols-[8rem_1fr] py-4 text-sm gap-4 xs:gap-16 lg:gap-32 group">
                                    <div class="flex items-center gap-2">
                                        <div class="h-5 aspect-square">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="filter-theme icon icon-tabler icons-tabler-outline icon-tabler-lock"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z" /><path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" /><path d="M8 11v-4a4 4 0 1 1 8 0v4" /></svg>
                                        </div>
                                        <div class="text-[--text-primary] font-medium">{{t "Access"}}</div>
                                    </div>
                                    <div class="flex items-center ml-auto">
                                            <div class="text-[--text-primary]">{{t "FREE Plan"}}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="h-px w-full bg-[--border-color]"></div>
                    <div class="wrapper flex flex-col items-center">
                        <div class="flex flex-col">
                            <h2 class="font-heading text-[--text-primary] text-xl font-medium leading-none text-center">{{t "Upgrade your plan"}}</h2>
                        </div>
                        {{> membership-pricing isFree=true isAccount=true}}
                    </div>
                </div>
        </div>
    </section>
