{{!-- Load font styles based on Ghost Admin settings. You can read the documentation to add more fonts --}}
{{!-- Primary Font --}}
{{#if @custom.primary_font}}
    {{#match @custom.primary_font "Alegreya"}}
        <link rel="preload stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..900;1,400..900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" crossorigin>
        <noscript><link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet"></noscript>
        <style>body{--font-primary:'Alegreya';}</style>
    {{/match}}
    {{#match @custom.primary_font "Newsreader"}}
        <link rel="preload stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" crossorigin>
