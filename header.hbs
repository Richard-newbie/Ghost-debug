<header class="fixed z-1000 top-0 left-0 w-full bg-[--header-bg]">
    <div class="border-b border-[--border-color]">
        <nav class="wrapper flex items-center justify-between">
            {{!-- Site logo --}}
            {{> logo}}
            <div class="flex py-5 items-center gap-3 sm:gap-5 lg:gap-10">
                <div class="order-3 lg:order-1 flex items-center gap-10">
                    {{!-- Mobile navigation buttons --}}
                    <button aria-label="mobile-nav" id="mobile-nav" data-open="false" class="size-8 rounded-full flex lg:hidden items-center justify-center hover:bg-[--nav-btn-hover] group peer">
                        <img src="{{asset "img/mobile-nav.svg"}}" alt="mobile-nav-icon" class="h-4/5 w-auto filter-theme block group-data-[open='true']:hidden" aria-hidden="true" />
                        <img src="{{asset "img/close.svg"}}" alt="close-icon" class="h-4/5 w-auto filter-theme block group-data-[open='false']:hidden" aria-hidden="true" />
                    </button>
                    <div id="nav-items" class="absolute top-[calc(4.5rem+1px)] left-0 w-full lg:w-auto lg:static grid peer-data-[open='false']:grid-rows-[0fr] [transition:grid-template-rows_ease-in-out_300ms] peer-data-[open='true']:grid-rows-[1fr] lg:peer-data-[open='true']:grid-rows-[1fr] lg:peer-data-[open='false']:grid-rows-[1fr]">
                        <div class="overflow-hidden lg:overflow-visible z-10">
                            <ul id="primary-navigation" class="text-sm font-medium capitalize flex flex-col lg:flex-row lg:items-center gap-5 lg:gap-8 bg-[--header-bg] lg:bg-transparent p-5 lg:p-0 border-b border-[--border-color] lg:border-0">
                                {{navigation}}
                                {{#if @site.members_enabled}}
                                    <li class="static-menu block sm:hidden">
                                        {{!-- Show button based on visitor's logged in status --}}
                                        {{#if @member}}
                                            <a aria-label="Account"  href="/account/" {{#if @custom.use_portal_links}} data-portal="account"{{/if}} class="inline-block bg-[--subscribe-btn-bg] hover:bg-[--subscribe-btn-hover] rounded-sm px-3 py-2.5 duration-300 text-xs font-medium uppercase text-[--subscribe-btn-text] leading-none">{{t "Account"}}</a>
                                        {{else}}
                                           <a aria-label="JOIN" href="/subscribe/" {{#if @custom.use_portal_links}} data-portal="JOIN"{{/if}} class="inline-block bg-[--subscribe-btn-bg] hover:bg-[--subscribe-btn-hover] rounded-sm px-3 py-2.5 duration-300 text-xs font-medium uppercase text-[--subscribe-btn-text] leading-none">{{t "JOIN"}}</a>
                                        {{/if}}
                                    </li>
                                {{/if}}
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="order-1 lg:order-2 flex items-center gap-3 sm:gap-5 lg:gap-10">
                    {{!-- Search button --}}
                    <button data-ghost-search aria-label="search" class="search-btn size-8 rounded-full flex items-center justify-center hover:bg-[--nav-btn-hover]">
                        <img src="{{asset "img/search.svg"}}" alt="search-icon" class="h-4/5 w-auto filter-theme" aria-hidden="true" />
                    </button>
                    {{!-- Dark/Light mode button --}}
                    <button id="theme-toggler" aria-label="theme-toggle" class="size-8 rounded-full flex items-center justify-center hover:bg-[--nav-btn-hover]">
                        <img src="{{asset "img/moon.svg"}}" alt="dark-mode-icon" class="moon h-4/5 w-auto filter-theme" aria-hidden="true" />
                        <img src="{{asset "img/sun.svg"}}" alt="light-mode-icon" class="sun h-4/5 w-auto filter-theme" aria-hidden="true" />
                    </button>
                </div>
                <div class="order-2 lg:order-3 flex items-center gap-5 lg:gap-10">
                    {{#if @custom.enable_multilingual_features}}
                        <div data-open="false" id="lang-switcher" tabindex="0">
                            <div class="absolute top-0 left-0 h-full w-full -z-50 cursor-pointer"></div>
                            <button id="lang-switcher-btn" aria-label="change-language" class="group"></button>
                            <ul class="lang-switcher-content scrollable" id="lang-switcher-content"></ul>
                        </div>
                    {{/if}}
                    {{!-- Show button based on visitor's logged in status --}}
                    {{#if @site.members_enabled}}
                        {{#if @member}}
                            <a aria-label="Account"  href="/account/" {{#if @custom.use_portal_links}} data-portal="ACCOUNT"{{/if}} class="header-btn hidden sm:inline-block bg-[--subscribe-btn-bg] hover:bg-[--subscribe-btn-hover] rounded-sm px-3 py-2.5 duration-300 text-xs font-medium uppercase text-[--subscribe-btn-text: #080808 !important] leading-none">{{t "Account"}}</a>
                        {{else}}
                            <a aria-label="JOIN" href="javascript:" data-portal="signup" class="header-btn hidden sm:inline-block bg-[--subscribe-btn-bg] hover:bg-[--subscribe-btn-hover] rounded-sm px-3 py-2.5 duration-300 text-xs font-medium uppercase text-[--subscribe-btn-text: #080808 !important] leading-none">{{t "JOIN"}}</a>
                        {{/if}}
                    {{/if}}
                </div>
            </div>
        </nav>
    </div>
    {{#match @custom.secondary_navigation_in_header "Secondary Navigation"}}
        {{> header-secondary-nav}}
    {{/match}}
    {{#match @custom.secondary_navigation_in_header "Top Tags"}}
        {{> header-categories}}
    {{/match}}
  
