<section class="py-10 {{^if isAccount}}xs:py-12 md:py-16{{/if}}">
    <div class="wrapper flex flex-col gap-12">
        {{^if isAccount}}
        <div class="mx-auto flex flex-col justify-center items-center gap-4 xs:gap-6 lg:gap-8 max-w-[32rem]">
            <h1 class="font-heading text-[--text-primary] text-2xl xs:text-4xl lg:text-[2.75rem] font-medium leading-none text-center">
                {{t "Membership"}}</h1>
            <p class="text-[--text-secondary] font-medium text-sm xs:text-base text-center">
                {{custom_excerpt}}
            </p>
        </div>
        {{/if}}
        <div class="mx-auto flex flex-col justify-center items-center gap-4 xs:gap-6 lg:gap-8 max-w-[32rem]">
            <p class="text-[--text-secondary] font-medium text-sm xs:text-base text-center">
                {{#if isFree}}
                    You have FREE membership. Upgrade to unlock more features and access to premium content. Start by choosing a plan below.
                {{/if}}
            </p>
        </div>
        <div class="mx-auto inline-grid grid-cols-2 border border-[--text-primary] rounded-sm">

            <label for="monthly" class="px-8 py-2 cursor-pointer text-[--text-primary] has-[:checked]:text-[--bg-color] has-[:checked]:bg-[--text-primary] text-sm font-medium text-center">
                {{t "Monthly"}}<input aria-label="monthly" type="radio" name="pricing" id="monthly" class="hidden"/>
            </label>
            <label for="yearly" class="px-8 py-2 cursor-pointer text-[--text-primary] has-[:checked]:text-[--bg-color] has-[:checked]:bg-[--text-primary] text-sm font-medium text-center">
                {{t "Yearly"}}<input aria-label="yearly" type="radio" name="pricing" id="yearly" class="hidden" checked/>
            </label>
        </div>
        <div class="grid grid-cols-1 xs:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-5 md:gap-8">
        {{#get "tiers" include="monthly_price,yearly_price,benefits" limit="100" as |tiers|}}
            {{#foreach tiers}}
                {{> membership-pricing-card}}
            {{/foreach}}
        {{/get}}
        </div>
    </div>
</section>
