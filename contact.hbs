{{!< default}}
{{#contentFor 'title' }}{{t "Contact" }}{{/contentFor}}
{{#if @custom.enable_multilingual_features}}
    {{#contentFor 'hreflangs'}}
    {{!-- IMPORTANT: If you make any changes here, please copy these to error.hbs --}}
    {{!-- Main Language at www.example.com --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/contact/" hreflang="{{@custom.main_locale}}" />
        <link rel="alternate" href="{{@custom.main_locale_url}}/contact/" hreflang="x-default" />

        {{!-- If
            USE_LOCALE_DOMAINS = false
            LOCALE_DOMAIN_HOME_ONLY = false
            All Other Languages at www.example.com/hi/my-blog or www.example.com/es/my-blog etc.
        --}}
        <link rel="alternate" href="{{@custom.main_locale_url}}/hi/contact/" hreflang="hi" />
        <link rel="alternate" href="{{@custom.main_locale_url}}/es/contact/" hreflang="es" />

    {{!-- If
        USE_LOCALE_DOMAINS = true
        LOCALE_DOMAIN_HOME_ONLY = false
        All Other Languages at www.hindidomain.com/my-blog, www.spanishdomain.com/my-blog etc.
    --}}
    {{!--
    <link rel="alternate" href="www.hindidomain.com{{url}}" hreflang="hi" />
    <link rel="alternate" href="www.spanishdomain.com{{url}}" hreflang="es" />
    --}}

    {{!-- If
        LOCALE_DOMAIN_HOME_ONLY = true
        We cannot determine if all blogs/pages would be translated, so we do not add any alternate hreflangs.
    --}}
    {{/contentFor}}
{{/if}}
<section class="section-contact py-10 xs:py-12 md:py-16">
  <div class="wrapper flex flex-col items-center gap-12">
    <div class="flex flex-col gap-2 xs:gap-4">
      <h1 class="section-contact-title font-heading text-[--text-primary] text-4xl xs:text-[2.75rem] md:text-5xl lg:text-[3.5rem] font-medium leading-none text-center">
        {{t "Contact"}} </h1>
    </div>

    {{!-- <div class="grid grid-cols-1 gap-16 lg:gap-12"> --}} {{!-- Uncomment this and comment below code if not using contact form --}}
    <div id="js-contact-wrapper" class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-12">
      <div class="section-contact-social-links order-2 lg:order-1 flex flex-col gap-16">
        <div>
            {{!-- Support Email --}}
            {{#if @site.members_support_address}}
                <a id="contact-email-link" href="mailto:{{@site.members_support_address}}" class="grid grid-cols-[2rem_1fr] md:grid-cols-[8rem_1fr] py-4 border-b border-[--border-color] text-sm gap-4 xs:gap-16 lg:gap-32 group">
                    <div class="flex items-center gap-2">
                        <div class="h-5 aspect-square">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" /><path d="M3 7l9 6l9 -6" /></svg>
                        </div>
                        <div class="text-[--text-primary] font-medium hidden md:block">{{t "Email"}}</div>
                    </div>
                    <div class="flex items-center ml-auto">
                        <div class="text-[--text-primary]">{{@site.members_support_address}}</div>
                        <img src="{{asset "img/redirect.svg"}}" alt="redirect" aria-hidden="true" class="px-4 h-6 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 lg:translate-y-1/4 lg:group-hover:translate-y-0 lg:-translate-x-1/4 group-hover:translate-x-0 transition-all filter-theme" />
                    </div>
                </a>
            {{/if}}
            {{#social_accounts @site}}
                <a href="{{href}}" class="grid grid-cols-[2rem_1fr] md:grid-cols-[8rem_1fr] py-4 border-b border-[--border-color] text-sm gap-4 xs:gap-16 lg:gap-32 group">
                    <div class="flex items-center gap-2">
                        <div class="h-5 aspect-square">
                            {{#match type "x"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-x"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
                            {{/match}}
                            {{#match type "facebook"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg>
                            {{/match}}
                            {{#match type "linkedin"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
                            {{/match}}
                            {{#match type "bluesky"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-bluesky"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6.335 5.144c-1.654 -1.199 -4.335 -2.127 -4.335 .826c0 .59 .35 4.953 .556 5.661c.713 2.463 3.13 2.75 5.444 2.369c-4.045 .665 -4.889 3.208 -2.667 5.41c1.03 1.018 1.913 1.59 2.667 1.59c2 0 3.134 -2.769 3.5 -3.5c.333 -.667 .5 -1.167 .5 -1.5c0 .333 .167 .833 .5 1.5c.366 .731 1.5 3.5 3.5 3.5c.754 0 1.637 -.571 2.667 -1.59c2.222 -2.203 1.378 -4.746 -2.667 -5.41c2.314 .38 4.73 .094 5.444 -2.369c.206 -.708 .556 -5.072 .556 -5.661c0 -2.953 -2.68 -2.025 -4.335 -.826c-2.293 1.662 -4.76 5.048 -5.665 6.856c-.905 -1.808 -3.372 -5.194 -5.665 -6.856z" /></svg>
                            {{/match}}
                            {{#match type "threads"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-threads"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 7.5c-1.333 -3 -3.667 -4.5 -7 -4.5c-5 0 -8 2.5 -8 9s3.5 9 8 9s7 -3 7 -5s-1 -5 -7 -5c-2.5 0 -3 1.25 -3 2.5c0 1.5 1 2.5 2.5 2.5c2.5 0 3.5 -1.5 3.5 -5s-2 -4 -3 -4s-1.833 .333 -2.5 1" /></svg>
                            {{/match}}
                            {{#match type "mastodon"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-mastodon"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M18.648 15.254c-1.816 1.763 -6.648 1.626 -6.648 1.626a18.262 18.262 0 0 1 -3.288 -.256c1.127 1.985 4.12 2.81 8.982 2.475c-1.945 2.013 -13.598 5.257 -13.668 -7.636l-.026 -1.154c0 -3.036 .023 -4.115 1.352 -5.633c1.671 -1.91 6.648 -1.666 6.648 -1.666s4.977 -.243 6.648 1.667c1.329 1.518 1.352 2.597 1.352 5.633s-.456 4.074 -1.352 4.944z" /><path d="M12 11.204v-2.926c0 -1.258 -.895 -2.278 -2 -2.278s-2 1.02 -2 2.278v4.722m4 -4.722c0 -1.258 .895 -2.278 2 -2.278s2 1.02 2 2.278v4.722" /></svg>
                            {{/match}}
                            {{#match type "tiktok"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-tiktok"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z" /></svg>
                            {{/match}}
                            {{#match type "youtube"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-youtube"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z" /><path d="M10 9l5 3l-5 3z" /></svg>
                            {{/match}}
                            {{#match type "instagram"}}
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M16.5 7.5v.01" /></svg>
                            {{/match}}
                        </div>
                        <div class="text-[--text-primary] font-medium hidden md:block">{{name}}</div>
                    </div>
                    <div class="flex items-center ml-auto">
                        <div class="text-[--text-primary]">{{href}}</div>
                        <img src="{{asset "img/redirect.svg"}}" alt="redirect" aria-hidden="true" class="px-4 h-6 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 lg:translate-y-1/4 lg:group-hover:translate-y-0 lg:-translate-x-1/4 group-hover:translate-x-0 transition-all filter-theme" />
                    </div>
                </a>
            {{/social_accounts}}
            <a id="contact-whatsapp-link" href="https://whatsapp.com/example" class="hidden grid grid-cols-[2rem_1fr] md:grid-cols-[8rem_1fr] py-4 border-b border-[--border-color] text-sm gap-4 xs:gap-16 lg:gap-32 group">
                <div class="flex items-center gap-2">
                    <div class="h-5 aspect-square">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-full filter-theme icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
                    </div>
                    <div class="text-[--text-primary] font-medium hidden md:block">{{t "Whatsapp"}}</div>
                </div>
                <div class="flex items-center ml-auto">
                    <div class="social-link text-[--text-primary]">https://whatsapp.com/example</div>
                    <img src="{{asset "img/redirect.svg"}}" alt="redirect" aria-hidden="true" class="px-4 h-6 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 lg:translate-y-1/4 lg:group-hover:translate-y-0 lg:-translate-x-1/4 group-hover:translate-x-0 transition-all filter-theme" />
                </div>
            </a>
        </div>
      </div>
      {{!-- Contact Form Endpoint --}}
      <form id="js-contact-form" action="https://your-form-endpoint.xyz/abc" method="POST" class="contact-form order-1 lg:order-2 grid grid-cols-1 xs:grid-cols-2 gap-6 xs:gap-8">
        <div>
          <label for="name" class="cursor-pointer inline-block text-[--text-primary] font-medium text-sm mb-1.5">{{t "Name"}}</label>
          <input type="text" name="name" id="name" required placeholder="Jamie Larsen" class="w-full border border-[--border-color] bg-transparent rounded-sm placeholder:text-[--text-secondary] text-[--text-primary] text-sm p-3 xs:p-3.5 outline-none" />
        </div>

        <div>
          <label for="email" class="cursor-pointer inline-block text-[--text-primary] font-medium text-sm mb-1.5">{{t "Email"}}</label>
          <input type="email" name="email" id="email" required placeholder="jamie@example.com" class="w-full border border-[--border-color] bg-transparent rounded-sm placeholder:text-[--text-secondary] text-[--text-primary] text-sm p-3 xs:p-3.5 outline-none" />
        </div>

        <div class="xs:col-span-2">
          <label for="message" class="cursor-pointer inline-block text-[--text-primary] font-medium text-sm mb-1.5">{{t "Message"}}</label>
          <textarea name="message" id="message" required class="w-full h-40 xs:h-48 border border-[--border-color] bg-transparent rounded-sm placeholder:text-[--text-secondary] text-[--text-primary] text-sm p-3 xs:p-3.5 outline-none resize-none"></textarea>
        </div>
        <button type="submit" class="xs:col-span-2 ml-auto w-full xs:w-auto inline-block bg-[--subscribe-btn-bg] hover:bg-[--subscribe-btn-hover] rounded-sm px-7 xs:px-8 py-2.5 xs:py-3 duration-300 text-sm font-medium uppercase text-[--subscribe-btn-text] leading-none">
          <div class="h-[26px] flex items-center justify-center">
            {{t "Send message"}}
          </div>
        </button>
      </form>

    </div>
  </div>
  </section>
<script>
    (function () {
    const endpoint = GLOBAL.CONTACT_ENDPOINT || "";
    const form = document.getElementById('js-contact-form');
    const wrapper = document.getElementById('js-contact-wrapper');

    if (!form || !wrapper) return;

    // If endpoint exists
    if (endpoint.trim() !== "") {
        form.action = endpoint;
        form.classList.remove('hidden');
        wrapper.classList.add('lg:grid-cols-2');
    } else {
        // No endpoint, hide form and remove wrapper layout class
        form.classList.add('hidden');
        wrapper.classList.remove('lg:grid-cols-2');
    }
    })();
</script>
<script>
    (function () {
        if (!window.GLOBAL) return;

        const url = (window.GLOBAL.WHATSAPP_LINK || '').trim();
        const el = document.getElementById('contact-whatsapp-link');
        if (!el) return;

        if (url) {
            el.href = url;
            el.classList.remove('hidden');

            const label = el.querySelector('.social-link');
            if (label) {
                label.textContent = url;
            }
        }
    })();
</script>
{{> join-populizt}}
