<div class="js-post-card flex flex-col {{#if feature_image}}justify-between{{/if}} gap-4 group">
    <div class="flex flex-col gap-4">
        {{#if feature_image}}
        <a aria-label="{{title}}" href="{{url}}">
            <div class="w-full aspect-[1.5] overflow-hidden rounded-sm relative">

                    {{> images/feature-image-xl show_caption=false classes="post-card-img h-full w-full object-cover object-center group-hover:scale-[1.025] transition-transform duration-300"}}

                {{> post-identifier-icons
                    div_classes="aspect-square rounded-sm flex items-center justify-center cursor-pointer absolute top-1 h-6 bg-black/50 backdrop-blur-lg right-1"
                    img_classes="filter-white h-4"
                    is_featured_icon_left=true
                }}
            </div>
            </a>
        {{/if}}
        <div class="flex flex-col gap-2">
            {{^is "tag"}}
                {{#if tags}}
                    <div class="post-card-tags flex items-center gap-2 flex-wrap">
                        {{#primary_tag}}
                            <a aria-label="{{name}}" href="{{url}}" class="text-sm text-[--text-accent] uppercase font-medium py-0.5 w-min rounded-sm text-nowrap"> {{name}} </a>
                        {{/primary_tag}}
                    </div>
                {{/if}}
            {{/is}}
            <a aria-label="{{title}}" class="flex flex-col gap-4" href="{{url}}">
                <h2 class="post-card-title font-heading text-[--text-primary] font-medium text-lg xs:text-xl hover:underline underline-offset-2"> {{title}} </h2>
                <p class="post-card-excerpt text-sm font-medium text-[--text-secondary] line-clamp-4"> {{excerpt}} </p>
            </a>
        </div>
    </div>
    <div class="post-card-meta flex flex-col gap-1">
        {{> post-meta}}
    </div>
</div>