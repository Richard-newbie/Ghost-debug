<!-- Stop Ghost from complaining: {{@custom.hero_right_column_posts_tag_slug}} -->
{{!-- Tag Slug --}}
{{#match @custom.hero_right_column_posts "Tag"}}
    {{#get "posts" limit="6" filter="primary_tag:{{@custom.hero_right_column_posts_tag_slug}}" include="tags,authors" order="published_at desc" as |tag_posts|}}
        {{#if tag_posts}}
            <div class="hero-right flex flex-col gap-10 xs:gap-5 md:gap-8 pb-10 md:pb-0 pt-10 md:pt-0">
                <h2 class="font-heading text-[--text-primary] text-xl xs:text-2xl lg:text-3xl font-medium leading-normal"> {{#get "tags" limit="1" filter="slug:{{@custom.hero_right_column_posts_tag_slug}}"}}{{#foreach tags}}{{name}}{{/foreach}}{{/get}} </h2>
                <div class="hidden md:block h-px bg-[--border-color]"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-10 xs:gap-5 md:gap-8">
                    {{#foreach tag_posts}}
                        {{> post-card-hero-right}}
                    {{/foreach}}
                </div>
            </div>
        {{/if}}
    {{/get}}
{{/match}}