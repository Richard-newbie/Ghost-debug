                                {{#foreach posts from="5"}}
                                    {{> post-card-hero-right}}
                                {{/foreach}}
                            </div>
                        </div>
                    {{/if}}
                {{/get}}
            {{/match}}
        {{else}}
            {{#match @custom.hero_left_column_posts "Featured Posts"}}
                {{!-- if carousel and left are featured --}}
