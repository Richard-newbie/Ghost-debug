{{!-- Markup to show the 6 right side latest posts on the homepage --}}
{{#match @custom.hero_right_column_posts "Featured Posts"}}
    {{#match @custom.carousel_slider_posts "Featured Posts"}}
        {{#match @custom.hero_center_column_posts "Featured Posts"}}
            {{#match @custom.hero_left_column_posts "Featured Posts"}}
                {{! -- if carousel, center and left are featured --}}
                {{#get "posts" limit="13" filter="featured:true" include="tags,authors" order="published_at desc"}}
                    {{#if posts}}
                        <div class="hero-right flex flex-col gap-10 xs:gap-5 md:gap-8 pb-10 md:pb-0 pt-10 md:pt-0">
                            <h2 class="font-heading text-[--text-primary] text-xl xs:text-2xl lg:text-3xl font-medium leading-normal"> {{t "Featured"}} </h2>
                            <div class="hidden md:block h-px bg-[--border-color]"></div>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-10 xs:gap-5 md:gap-8">
                                {{#foreach posts from="8"}}
                                    {{> post-card-hero-right}}
                                {{/foreach}}
                            </div>
                        </div>
                    {{/if}}
                {{/get}}
            {{else}}
                {{!-- if carousel and center are featured --}}
                {{#get "posts" limit="10" filter="featured:true" include="tags,authors" order="published_at desc"}}
                    {{#if posts}}
                        <div class="hero-right flex flex-col gap-10 xs:gap-5 md:gap-8 pb-10 md:pb-0 pt-10 md:pt-0">
